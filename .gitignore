# --- Not part of the web build -------------------------------------------

# 43 MB native Windows launcher (NW.js shell for the desktop build).
/omori.exe

# Local runtime artifacts. The desktop build writes here; the web build keeps
# its state in localStorage + IndexedDB instead.
/save/

# Ending-credits/cutscene videos. game.js rewrites every movies/ request to
# base.ini's CDN baseUrl (see the "origin for js/movies/fonts" rewriter), so
# these local copies are never read by the web build.
/movies/

# --- Editor / agent metadata ---------------------------------------------

/.freebuff/

# --- Libraries nothing loads ---------------------------------------------

# Steamworks bindings for NW.js: no code path in game.js or js/plugins/
# references them. (The web build cannot use them at all.)
/js/libs/greenworks.js
/js/libs/SteamConfig.ini

# T-RMix audio mixer + DragonBones runtime: unreferenced by the bundle.
/js/libs/trmix.min.js
/js/libs/dragonbones/
